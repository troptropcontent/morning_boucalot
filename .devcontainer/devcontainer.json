{
  "image": "mcr.microsoft.com/devcontainers/ruby:4.0",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    },
    "ghcr.io/devcontainers/features/docker-in-docker": {"moby": false}
  },
  "hostRequirements": {
    "cpus": 4
  },
  "waitFor": "onCreateCommand",
  "updateContentCommand": "bundle install && npm install",
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postAttachCommand": {
    "server": "bin/dev"
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "app/views/hello/index.html.erb"
      ]
    },
    "vscode": {
      "extensions": [
        "Shopify.ruby-lsp"
      ]
    }
  },
  "portsAttributes": {
    "3000": {
      "label": "Application",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [3000]
}
