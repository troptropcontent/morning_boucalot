{
  "name": "morning_boucalot",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/morning_boucalot",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker": { "moby": false },
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },
  "mounts": [
    "source=claude-code-config-${devcontainerId},target=/home/vscode/.claude,type=volume"
  ],
  "hostRequirements": {
    "cpus": 4
  },
  "waitFor": "onCreateCommand",
  "updateContentCommand": "bundle install && npm install && cd e2e && npm install",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "app/views/hello/index.html.erb"
      ]
    },
    "vscode": {
      "extensions": [
        "Shopify.ruby-lsp",
        "ms-playwright.playwright"
      ]
    }
  },
  "portsAttributes": {
    "3000": {
      "label": "Application"
    }
  },
  "forwardPorts": [3000]
}
