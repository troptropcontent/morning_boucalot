# Secrets are fetched from 1Password, from the PROD section of the ENV item in
# the MorningBoucalot vault (op://MorningBoucalot/ENV/PROD/<NAME>). The machine
# running `kamal deploy` needs the 1Password CLI (`op`) signed in to that
# account (e.g. via OP_SERVICE_ACCOUNT_TOKEN).
#
# GMAIL_APP_PASSWORD is a Gmail App Password, not the account password.
# FTP_INGEST_USER_EMAIL is the app user who owns FTP-offloaded photos.
# OFFLOAD_UPLOAD_TOKEN is the bearer token for POST /offload_uploads.

SECRETS=$(kamal secrets fetch --adapter 1password --account my.1password.eu --from MorningBoucalot/ENV PROD/KAMAL_REGISTRY_PASSWORD PROD/RAILS_MASTER_KEY PROD/DATABASE_URL PROD/QUEUE_DATABASE_URL PROD/S3_ACCESS_KEY_ID PROD/S3_SECRET_ACCESS_KEY PROD/S3_REGION PROD/S3_BUCKET_NAME PROD/S3_ENDPOINT PROD/S3_FORCE_PATH_STYLE PROD/GMAIL_USERNAME PROD/GMAIL_APP_PASSWORD PROD/FTP_INGEST_USER_EMAIL PROD/OFFLOAD_UPLOAD_TOKEN)

KAMAL_REGISTRY_PASSWORD=$(kamal secrets extract KAMAL_REGISTRY_PASSWORD $SECRETS)
RAILS_MASTER_KEY=$(kamal secrets extract RAILS_MASTER_KEY $SECRETS)
DATABASE_URL=$(kamal secrets extract DATABASE_URL $SECRETS)
QUEUE_DATABASE_URL=$(kamal secrets extract QUEUE_DATABASE_URL $SECRETS)
S3_ACCESS_KEY_ID=$(kamal secrets extract S3_ACCESS_KEY_ID $SECRETS)
S3_SECRET_ACCESS_KEY=$(kamal secrets extract S3_SECRET_ACCESS_KEY $SECRETS)
S3_REGION=$(kamal secrets extract S3_REGION $SECRETS)
S3_BUCKET_NAME=$(kamal secrets extract S3_BUCKET_NAME $SECRETS)
S3_ENDPOINT=$(kamal secrets extract S3_ENDPOINT $SECRETS)
S3_FORCE_PATH_STYLE=$(kamal secrets extract S3_FORCE_PATH_STYLE $SECRETS)
GMAIL_USERNAME=$(kamal secrets extract GMAIL_USERNAME $SECRETS)
GMAIL_APP_PASSWORD=$(kamal secrets extract GMAIL_APP_PASSWORD $SECRETS)
FTP_INGEST_USER_EMAIL=$(kamal secrets extract FTP_INGEST_USER_EMAIL $SECRETS)
OFFLOAD_UPLOAD_TOKEN=$(kamal secrets extract OFFLOAD_UPLOAD_TOKEN $SECRETS)
