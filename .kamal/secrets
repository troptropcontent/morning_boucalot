# Secrets are read from environment variables on the machine running `kamal deploy`.
# Export all of these before deploying:
#   export KAMAL_REGISTRY_PASSWORD=...
#   export RAILS_MASTER_KEY=$(cat config/master.key)
#   export DATABASE_URL=postgres://...
#   export S3_ACCESS_KEY_ID=...
#   export S3_SECRET_ACCESS_KEY=...
#   export S3_REGION=...
#   export S3_BUCKET_NAME=...
#   export S3_ENDPOINT=...
#   export S3_FORCE_PATH_STYLE=...

KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
RAILS_MASTER_KEY=$PRODUCTION_RAILS_MASTER_KEY
DATABASE_URL=$DATABASE_URL
S3_ACCESS_KEY_ID=$PRODUCTION_S3_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=$PRODUCTION_S3_SECRET_ACCESS_KEY
S3_REGION=$PRODUCTION_S3_REGION
S3_BUCKET_NAME=$PRODUCTION_S3_BUCKET_NAME
S3_ENDPOINT=$PRODUCTION_S3_ENDPOINT
S3_FORCE_PATH_STYLE=$PRODUCTION_S3_FORCE_PATH_STYLE
