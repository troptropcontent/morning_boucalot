# Development env, resolved from 1Password at boot. Only op:// references
# live here — no secret values — so this file is safe to commit.
#
#   op run --env-file=.env.1password -- bin/dev
#
# Format: op://<vault>/<item>/<section>/<field>

# Active Storage (development uses S3, see config/environments/development.rb)
S3_ACCESS_KEY_ID=op://MorningBoucalot/ENV/DEV/S3_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=op://MorningBoucalot/ENV/DEV/S3_SECRET_ACCESS_KEY
S3_REGION=op://MorningBoucalot/ENV/DEV/S3_REGION
S3_BUCKET_NAME=op://MorningBoucalot/ENV/DEV/S3_BUCKET_NAME
S3_ENDPOINT=op://MorningBoucalot/ENV/DEV/S3_ENDPOINT
S3_FORCE_PATH_STYLE=op://MorningBoucalot/ENV/DEV/S3_FORCE_PATH_STYLE

# Outgoing mail
GMAIL_USERNAME=op://MorningBoucalot/ENV/DEV/GMAIL_USERNAME
GMAIL_APP_PASSWORD=op://MorningBoucalot/ENV/DEV/GMAIL_APP_PASSWORD

# FTP ingest is skipped when unset. Not a secret — uncomment with a local
# path to exercise it in development.
# FTP_INCOMING_DIR=tmp/ftp_incoming
