<!DOCTYPE html>
<html data-theme="light">
  <head>
    <%= render "layouts/head" %>
  </head>

  <body class="bg-base-200 min-h-screen">
    <nav class="navbar bg-base-100 shadow-sm px-4">
      <div class="flex-1">
        <%= link_to "MorningBoucalot", root_path, class: "text-xl font-bold" %>
      </div>
      <% if authenticated? %>
        <div class="flex-none flex items-center gap-2">
          <% if Current.user.member? %>
            <%= link_to upload_user_photos_path(Current.user), class: "btn btn-primary btn-sm" do %>
              + Upload
            <% end %>
          <% end %>
          <%= button_to "Sign out", session_path, method: :delete, class: "btn btn-ghost btn-sm" %>
        </div>
      <% else %>
        <div class="flex-none">
          <%= link_to "Log in", new_session_path(return_to: request.fullpath), class: "btn btn-primary btn-sm" %>
        </div>
      <% end %>
    </nav>

    <%= render "layouts/flash_toast" %>

    <main class="container mx-auto px-4 py-6">
      <%= yield %>
    </main>
  </body>
</html>
