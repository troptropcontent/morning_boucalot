<!DOCTYPE html>
<html data-theme="light">
  <head>
    <title>Photolog</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= hotwire_livereload_tags if Rails.env.development? %>
  </head>

  <body class="bg-base-200 min-h-screen">
    <nav class="navbar bg-base-100 shadow-sm px-4">
      <div class="flex-1">
        <%= link_to "MorningBoucalot", root_path, class: "text-xl font-bold" %>
      </div>
      <% if authenticated? %>
        <div class="flex-none flex items-center gap-2">
          <%= link_to upload_photos_path, class: "btn btn-primary btn-sm" do %>
            + Upload
          <% end %>
          <%= button_to "Sign out", session_path, method: :delete, class: "btn btn-ghost btn-sm" %>
        </div>
      <% end %>
    </nav>

    <div id="flash" class="toast toast-bottom toast-center z-50">
      <%= render "layouts/flash" %>
    </div>

    <main class="container mx-auto px-4 py-6">
      <%= yield %>
    </main>
  </body>
</html>
