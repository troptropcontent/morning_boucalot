<div class="flex justify-between items-center mb-6">
  <div>
    <%= link_to "← Albums", albums_path, class: "link link-primary text-sm" %>
    <h1 class="text-2xl font-bold mt-1"><%= @album.title %></h1>
    <% if @album.description.present? %>
      <p class="text-base-content/60 mt-1"><%= @album.description %></p>
    <% end %>
  </div>
  <div class="flex gap-2">
    <%= link_to "Edit", edit_album_path(@album), class: "btn btn-outline btn-sm" %>
    <%= button_to "Delete", album_path(@album), method: :delete,
        data: { turbo_confirm: "Delete this album?" },
        class: "btn btn-error btn-sm" %>
  </div>
</div>

<% if @photos.empty? %>
  <div class="text-center py-20 text-base-content/50">
    <p>No photos in this album yet.</p>
  </div>
<% else %>
  <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3" id="album-photos">
    <% @album.album_photos.includes(photo: { file_attachment: :blob }).order(:position, :created_at).each do |album_photo| %>
      <div id="album_photo_<%= album_photo.id %>" class="relative group">
        <%= link_to photo_path(album_photo.photo) do %>
          <div class="aspect-square overflow-hidden rounded-lg bg-base-300 hover:opacity-90 transition-opacity">
            <% if album_photo.photo.file.attached? %>
              <%= image_tag album_photo.photo.thumbnail, class: "w-full h-full object-cover" %>
            <% end %>
          </div>
        <% end %>
        <%= button_to album_photo_path(album_photo), method: :delete,
            data: { turbo_confirm: "Remove from album?" },
            class: "absolute top-1 right-1 btn btn-xs btn-error opacity-0 group-hover:opacity-100 transition-opacity" do %>
          ✕
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
