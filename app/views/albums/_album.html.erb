<div class="card bg-base-100 shadow hover:shadow-md transition-shadow">
  <%= link_to album_path(album) do %>
    <div class="aspect-video bg-base-300 overflow-hidden rounded-t-2xl">
      <% if album.cover_photo&.file&.attached? %>
        <%= image_tag album.cover_photo.thumbnail, class: "w-full h-full object-cover" %>
      <% else %>
        <div class="w-full h-full flex items-center justify-center text-base-content/30 text-sm">
          No cover
        </div>
      <% end %>
    </div>
  <% end %>
  <div class="card-body py-3 px-4">
    <h2 class="card-title text-base"><%= album.title %></h2>
    <p class="text-xs text-base-content/50"><%= album.photos.count %> photos</p>
  </div>
</div>
