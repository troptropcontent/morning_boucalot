<div class="mb-4">
  <%= link_to "← Back to offloaded photos", user_offloaded_photos_path(@owner), class: "link link-primary text-sm" %>
</div>

<%
  preload_data = {}
  if @next_photo&.file&.attached?
    preload_data = { controller: "photo-preload", photo_preload_url_value: url_for(@next_photo.image_variant(:large)) }
  end
%>
<%= tag.div class: "md:flex md:justify-center", data: preload_data do %>
  <div class="md:inline-block">
    <div class="relative">
      <% if @photo.file.attached? %>
        <%= image_tag @photo.image_variant(:large),
            class: "rounded-lg w-full md:w-auto md:max-h-[calc(100vh-13rem)] md:object-contain" %>
      <% else %>
        <div class="py-20 text-center text-base-content/30 text-sm bg-base-300 rounded-lg">No preview — RAW only</div>
      <% end %>

      <%= render "shared/photo_nav_arrows",
          prev_url: @previous_photo ? user_offloaded_photo_path(@owner, @previous_photo) : nil,
          next_url: @next_photo ? user_offloaded_photo_path(@owner, @next_photo) : nil %>
    </div>

    <div class="mt-4">
      <%= render "actions", photo: @photo, owner: @owner, navigate: true %>
    </div>
  </div>
<% end %>
