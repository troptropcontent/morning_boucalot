<div data-controller="photo-selection"
     data-photo-selection-storage-key-value="<%= user_archived_photos_path(@owner) %>">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-xl font-bold">Trash</h1>
    <p class="text-sm text-base-content/50"><%= @pagy.count %> photo<%= "s" unless @pagy.count == 1 %></p>
  </div>

  <% if @photos.empty? %>
    <div class="text-center py-20 text-base-content/50">
      <p class="text-lg">Trash is empty.</p>
      <p class="text-sm mt-1">Photos you delete stick around here for 60 days before being removed for good.</p>
    </div>
  <% else %>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
      <% @photos.each do |photo| %>
        <%= render "photo", photo: photo, owner: @owner %>
      <% end %>
    </div>

    <% if @pagy.pages > 1 %>
      <div class="flex justify-center mt-8">
        <%= pagy_nav(@pagy) %>
      </div>
    <% end %>

    <div data-photo-selection-target="toolbar"
         class="hidden fixed bottom-0 inset-x-0 bg-base-100 border-t border-base-300 p-3 flex items-center justify-between gap-2 z-30">
      <span data-photo-selection-target="count" class="text-sm"></span>
      <div class="flex gap-2">
        <%= form_with url: batch_restore_user_archived_photos_path(@owner), method: :patch do |f| %>
          <%= f.submit "Restore", class: "btn btn-primary btn-sm",
              data: { action: "click->photo-selection#submitDelete" } %>
        <% end %>
        <%= form_with url: user_archived_photos_path(@owner), method: :delete,
            data: { turbo_confirm: "Permanently delete the selected photos? This cannot be undone." } do |f| %>
          <%= f.submit "Delete forever", class: "btn btn-error btn-sm",
              data: { action: "click->photo-selection#submitDelete" } %>
        <% end %>
        <button class="btn btn-ghost btn-sm" data-action="photo-selection#cancel">
          Cancel
        </button>
      </div>
    </div>
  <% end %>
</div>
