<div class="card bg-base-100 shadow w-full max-w-sm">
  <div class="card-body">
    <h1 class="card-title text-2xl mb-4">Sign in</h1>

    <%
      # Which tab opens on load — Guest by default (the common case), unless
      # ?tab=member says otherwise. A no-JS redirect back here (e.g. a failed
      # login on either tab) passes the tab it came from, so it reopens on
      # the same tab instead of silently resetting to Guest.
      guest_tab_open = params[:tab] != "member"
    %>

    <%# DaisyUI's radio-input tabs — pure CSS, no JS needed to switch panels.
        tabs-border (an underline, not a boxed/lifted panel) reads better here
        since the tabs already sit inside a card — a second nested box looked
        cluttered. %>
    <div class="tabs tabs-border w-full justify-center mb-6" role="tablist">
      <input type="radio" name="login_tabs" role="tab" class="tab flex-1 text-base font-medium checked:text-primary" aria-label="Member" <%= "checked" unless guest_tab_open %> />
      <div role="tabpanel" class="tab-content pt-6">
        <%= form_with url: session_url do |form| %>
          <div class="form-control mb-4">
            <%= form.label :email_address, "Email", class: "label" %>
            <%= form.email_field :email_address, required: true, autofocus: true,
                autocomplete: "username", placeholder: "you@example.com",
                value: params[:email_address],
                class: "input input-bordered w-full" %>
          </div>

          <div class="form-control mb-6">
            <%= form.label :password, "Password", class: "label" %>
            <div class="relative" data-controller="password-visibility">
              <%= form.password_field :password, required: true,
                  autocomplete: "current-password", placeholder: "••••••••",
                  maxlength: 72, class: "input input-bordered w-full pr-16",
                  data: { password_visibility_target: "input" } %>
              <button type="button"
                  class="absolute right-2 top-1/2 -translate-y-1/2 px-2 py-2 text-sm font-medium text-primary rounded focus-visible:outline-primary"
                  data-action="password-visibility#toggle"
                  data-password-visibility-target="button"
                  aria-pressed="false"
                  aria-label="Show password">Show</button>
            </div>
          </div>

          <%= form.submit "Sign in", class: "btn btn-primary w-full", data: { turbo_submits_with: "Signing in…" } %>
        <% end %>

        <div class="text-center mt-4">
          <%= link_to "Forgot password?", new_password_path, class: "link link-primary text-sm" %>
        </div>
      </div>

      <input type="radio" name="login_tabs" role="tab" class="tab flex-1 text-base font-medium checked:text-primary" aria-label="Guest" <%= "checked" if guest_tab_open %> />
      <div role="tabpanel" class="tab-content pt-6">
        <%= turbo_frame_tag "guest_login" do %>
          <% if session[:guest_otp] %>
            <%= render "guest_sessions/code_form" %>
          <% else %>
            <%= render "guest_sessions/email_form" %>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</div>
