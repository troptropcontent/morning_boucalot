<p class="text-sm text-base-content/70 mb-4">No password needed — we'll email you a one-time code.</p>

<%= form_with url: guest_session_path, class: "contents" do |form| %>
  <div class="form-control mb-4">
    <%= form.label :email_address, "Email", class: "label" %>
    <%= form.email_field :email_address, required: true,
        autocomplete: "email", placeholder: "you@example.com",
        class: "input input-bordered w-full" %>
  </div>

  <%= form.submit "Send code", class: "btn btn-primary w-full" %>
<% end %>
