<%# locals: (photo:, prev_photo: nil, next_photo: nil) %>
<div class="mb-4">
  <%= link_to "← Back to photos", user_photos_path(@owner, tag: params[:tag].presence, favorited: params[:favorited].presence), class: "link link-primary text-sm" %>
</div>

<%
  preload_data = {}
  if next_photo&.file&.attached?
    preload_data = { controller: "photo-preload", photo_preload_url_value: url_for(next_photo.file.variant(:large)) }
  end
%>
<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <%= tag.div class: "lg:col-span-2 relative", data: preload_data do %>
    <% if photo.file.attached? %>
      <%= image_tag photo.file.variant(:large), class: "rounded-lg w-full" %>
    <% end %>
    <% if prev_photo %>
      <%= link_to user_photo_path(@owner, prev_photo, tag: params[:tag].presence, favorited: params[:favorited].presence), class: "absolute left-0 top-0 h-full flex items-center px-2", aria: { label: "Previous photo" } do %>
        <div class="bg-black/40 rounded-full p-3 text-white">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
        </div>
      <% end %>
    <% end %>
    <% if next_photo %>
      <%= link_to user_photo_path(@owner, next_photo, tag: params[:tag].presence, favorited: params[:favorited].presence), class: "absolute right-0 top-0 h-full flex items-center px-2", aria: { label: "Next photo" } do %>
        <div class="bg-black/40 rounded-full p-3 text-white">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </div>
      <% end %>
    <% end %>
  <% end %>

  <%= turbo_frame_tag "photo_details" do %>
    <%= yield %>
  <% end %>
</div>
