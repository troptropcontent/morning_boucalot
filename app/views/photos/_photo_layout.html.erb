<%# locals: (photo:, owner:, filter:, prev_photo: nil, next_photo: nil) %>
<div class="mb-4">
  <%= link_to "← Back to photos", user_photos_path(owner, **filter.to_params), class: "link link-primary text-sm" %>
</div>

<%
  preload_data = {}
  if next_photo&.file&.attached?
    preload_data = { controller: "photo-preload", photo_preload_url_value: url_for(next_photo.file.variant(:large)) }
  end
%>
<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <%= tag.div class: "lg:col-span-2 relative", data: preload_data do %>
    <% if photo.file.attached? %>
      <%= image_tag photo.file.variant(:large), class: "rounded-lg w-full" %>
    <% end %>
    <%= render "shared/photo_nav_arrows",
        prev_url: prev_photo ? user_photo_path(owner, prev_photo, **filter.to_params) : nil,
        next_url: next_photo ? user_photo_path(owner, next_photo, **filter.to_params) : nil %>
  <% end %>

  <%= turbo_frame_tag "photo_details" do %>
    <%= yield %>
  <% end %>
</div>
