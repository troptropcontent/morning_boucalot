<%= render layout: "photos/photo_layout", locals: { photo: @photo } do %>
  <div class="space-y-4">
    <%= form_with model: @photo, data: { turbo_action: "replace" } do |f| %>
      <div class="form-control">
        <%= f.label :title, class: "label" %>
        <%= f.text_field :title, class: "input input-bordered w-full", placeholder: "Optional title" %>
      </div>

      <div class="form-control">
        <%= f.label :description, class: "label" %>
        <%= f.text_area :description, rows: 4, class: "textarea textarea-bordered w-full", placeholder: "Optional description" %>
      </div>

      <div class="flex gap-2 pt-2">
        <%= f.submit "Save", class: "btn btn-primary btn-sm" %>
        <%= link_to "Cancel", photo_path(@photo), class: "btn btn-ghost btn-sm", data: { turbo_action: "replace" } %>
      </div>
    <% end %>
  </div>
<% end %>
