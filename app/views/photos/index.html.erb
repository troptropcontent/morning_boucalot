<p class="text-sm text-base-content/50 mb-6"><%= @pagy.count %> photo<%= "s" unless @pagy.count == 1 %></p>

<% if @photos.empty? %>
  <div class="text-center py-20 text-base-content/50">
    <p class="text-lg">No photos yet.</p>
    <%= link_to "Upload your first photo", upload_photos_path, class: "link link-primary" %>
  </div>
<% else %>
  <% @photos.group_by { |p| (p.taken_at || p.created_at).beginning_of_month }.each do |month, photos| %>
    <div class="mb-8">
      <h2 class="text-sm font-semibold text-base-content/60 uppercase tracking-wide mb-3">
        <%= month.strftime("%B %Y") %>
      </h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-1">
        <% photos.each do |photo| %>
          <%= render "photo", photo: photo %>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if @pagy.pages > 1 %>
    <div class="flex justify-center mt-8">
      <%== pagy_nav(@pagy) %>
    </div>
  <% end %>
<% end %>
