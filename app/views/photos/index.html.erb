<div data-controller="photo-selection"
     data-photo-selection-download-url-value="<%= download_zip_user_photos_path(@owner) %>"
     data-photo-selection-storage-key-value="<%= user_photos_path(@owner) %>">
  <turbo-frame id="photos-index" data-turbo-action="advance">
    <p class="text-sm text-base-content/50 mb-6"><%= @pagy.count %> photo<%= "s" unless @pagy.count == 1 %></p>

    <% if @photos.empty? %>
      <div class="text-center py-20 text-base-content/50">
        <% if params[:tag].present? %>
          <p class="text-lg">No photos tagged "<%= params[:tag] %>".</p>
          <%= link_to "View all photos", user_photos_path(@owner), class: "link link-primary" %>
        <% else %>
          <p class="text-lg">No photos yet.</p>
          <% if authenticated? && Current.user == @owner %>
            <%= link_to "Upload your first photo", upload_user_photos_path(@owner), class: "link link-primary" %>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <% @photos.group_by { |p| (p.taken_at || p.created_at).beginning_of_month }.each do |month, photos| %>
        <div class="mb-8">
          <h2 class="text-sm font-semibold text-base-content/60 uppercase tracking-wide mb-3">
            <%= month.strftime("%B %Y") %>
          </h2>
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-1">
            <% photos.each do |photo| %>
              <%= render "photo", photo: photo %>
            <% end %>
          </div>
        </div>
      <% end %>

      <% if @pagy.pages > 1 %>
        <div class="flex justify-center mt-8">
          <%= pagy_nav(@pagy) %>
        </div>
      <% end %>
    <% end %>
  </turbo-frame>

  <%# Floating action bar — outside the frame so it persists across pagination %>
  <div data-photo-selection-target="toolbar"
       class="hidden fixed bottom-6 inset-x-4 z-40 flex items-center justify-between gap-3 bg-base-100 shadow-xl rounded-2xl px-4 py-3">
    <span class="text-sm font-semibold" data-photo-selection-target="count"></span>
    <div class="flex gap-2">
      <% if authenticated? && Current.user == @owner %>
        <div class="dropdown dropdown-top">
          <label tabindex="0" class="btn btn-neutral btn-sm">Download ▾</label>
          <ul tabindex="0" class="dropdown-content menu bg-base-100 rounded-box shadow w-44 mb-1 z-50">
            <li>
              <button data-action="click->photo-selection#download"
                      data-photo-selection-variant-param="original">
                Original
              </button>
            </li>
            <li>
              <button data-action="click->photo-selection#download"
                      data-photo-selection-variant-param="large">
                Large (2400px)
              </button>
            </li>
          </ul>
        </div>
        <button class="btn btn-primary btn-sm" data-action="photo-selection#openTagModal">
          Add tag
        </button>
      <% end %>
      <button class="btn btn-ghost btn-sm" data-action="photo-selection#cancel">
        Cancel
      </button>
    </div>
  </div>

  <%# Batch tag modal — also outside the frame %>
  <% if authenticated? && Current.user == @owner %>
    <dialog id="batch-tag-modal" class="modal">
      <div class="modal-box">
        <h3 class="font-bold text-lg mb-4">Add tags to selection</h3>
        <%= form_with url: batch_user_photos_path(@owner), method: :patch do |f| %>
          <div class="form-control mb-4">
            <%= f.label :tag_list, "Tags", class: "label" %>
            <%= f.text_field :tag_list, class: "input input-bordered w-full",
                placeholder: "landscape, travel", autocomplete: "off" %>
            <p class="text-xs text-base-content/50 mt-1">Tags will be added to each selected photo.</p>
          </div>
          <div class="modal-action">
            <button type="button" class="btn btn-ghost"
                    onclick="document.getElementById('batch-tag-modal').close()">Cancel</button>
            <%= f.submit "Add tags", class: "btn btn-primary",
                data: { action: "click->photo-selection#submitTags" } %>
          </div>
        <% end %>
      </div>
      <form method="dialog" class="modal-backdrop"><button>close</button></form>
    </dialog>
  <% end %>
</div>
