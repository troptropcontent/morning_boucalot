<%# locals: (photo:, owner:, favorited:) %>
<div class="space-y-4">
  <div>
    <div class="flex items-center gap-2">
      <h1 class="text-2xl font-bold"><%= photo.title.presence || "Untitled" %></h1>
      <% if photo.pending? %>
        <span class="badge badge-warning badge-sm">Processing…</span>
      <% elsif photo.failed? %>
        <span class="badge badge-error badge-sm">Processing failed</span>
      <% end %>
    </div>
    <% if photo.description.present? %>
      <p class="text-base-content/70 mt-1"><%= photo.description %></p>
    <% end %>
  </div>

  <div class="divider"></div>

  <div class="space-y-2 text-sm">
    <% if photo.taken_at %>
      <div class="flex justify-between">
        <span class="text-base-content/60">Date taken</span>
        <span><%= photo.taken_at.strftime("%B %-d, %Y") %></span>
      </div>
    <% end %>
    <% if photo.camera_model %>
      <div class="flex justify-between">
        <span class="text-base-content/60">Camera</span>
        <span><%= photo.camera_model %></span>
      </div>
    <% end %>
    <% if photo.focal_length %>
      <div class="flex justify-between">
        <span class="text-base-content/60">Focal length</span>
        <span><%= photo.focal_length.to_i %>mm</span>
      </div>
    <% end %>
    <% if photo.aperture %>
      <div class="flex justify-between">
        <span class="text-base-content/60">Aperture</span>
        <span>f/<%= photo.aperture %></span>
      </div>
    <% end %>
    <% if photo.shutter_speed %>
      <div class="flex justify-between">
        <span class="text-base-content/60">Shutter speed</span>
        <span><%= photo.shutter_speed %></span>
      </div>
    <% end %>
    <% if photo.iso %>
      <div class="flex justify-between">
        <span class="text-base-content/60">ISO</span>
        <span><%= photo.iso %></span>
      </div>
    <% end %>
  </div>

  <div class="divider"></div>

  <div class="flex gap-2 items-center">
    <%= render "photos/favorite_button", photo: photo, owner: owner, favorited: favorited %>
    <% if photo.file.attached? %>
      <div class="dropdown dropdown-top">
        <div tabindex="0" role="button" class="btn btn-outline btn-sm">
          Download
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 ml-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" />
          </svg>
        </div>
        <ul tabindex="0" class="dropdown-content menu bg-base-100 border border-base-300 rounded-box z-10 w-52 p-2 shadow-lg">
          <li>
            <%= link_to rails_blob_path(photo.file, disposition: "attachment") do %>
              <div>
                <span class="font-medium">Original HD</span>
                <span class="text-xs text-base-content/60 block">Full resolution file</span>
              </div>
            <% end %>
          </li>
          <li>
            <%= link_to rails_representation_path(photo.file.variant(:large), disposition: "attachment") do %>
              <div>
                <span class="font-medium">Web / Social</span>
                <span class="text-xs text-base-content/60 block">Optimised, up to 2400px</span>
              </div>
            <% end %>
          </li>
        </ul>
      </div>
    <% end %>
    <% if owner_of?(owner) %>
      <%= link_to "Edit", edit_user_photo_path(owner, photo), class: "btn btn-outline btn-sm", data: { turbo_action: "advance" } %>
      <%= button_to "Delete", user_photo_path(owner, photo), method: :delete,
          data: { turbo_confirm: "Delete this photo?" },
          class: "btn btn-error btn-sm" %>
    <% end %>
  </div>
</div>
