<%= form_with model: photo,
              url: photo.new_record? ? user_photos_path(@owner) : user_photo_path(@owner, photo),
              data: { controller: "photo-upload" } do |f| %>
  <div class="form-control mb-4">
    <%= f.label :file, "Photo", class: "label" %>
    <% if photo.file.attached? %>
      <div class="mb-2">
        <%= image_tag photo.thumbnail, class: "rounded w-32 h-32 object-cover" %>
      </div>
    <% end %>
    <%= f.file_field :file, accept: "image/*",
        class: "file-input file-input-bordered w-full",
        data: { photo_upload_target: "input", action: "change->photo-upload#preview" } %>
    <div data-photo-upload-target="preview" class="mt-2 hidden">
      <img data-photo-upload-target="previewImage" class="rounded w-32 h-32 object-cover" />
    </div>
  </div>

  <div class="form-control mb-4">
    <%= f.label :title, class: "label" %>
    <%= f.text_field :title, class: "input input-bordered w-full", placeholder: "Optional title" %>
  </div>

  <div class="form-control mb-4">
    <%= f.label :description, class: "label" %>
    <%= f.text_area :description, rows: 3, class: "textarea textarea-bordered w-full", placeholder: "Optional description" %>
  </div>

  <div class="form-control mb-6">
    <%= f.label :tag_list, "Tags", class: "label" %>
    <%= f.text_field :tag_list, class: "input input-bordered w-full", placeholder: "landscape, travel, portrait" %>
    <p class="text-xs text-base-content/50 mt-1">Separate tags with commas</p>
  </div>

  <div class="flex gap-2">
    <%= f.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", user_photos_path(@owner), class: "btn btn-ghost" %>
  </div>
<% end %>
