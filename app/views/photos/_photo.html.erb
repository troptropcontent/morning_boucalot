<%= link_to photo_path(photo), class: "block active:opacity-75 transition-opacity" do %>
  <div class="aspect-square overflow-hidden bg-base-300">
    <% if photo.file.attached? %>
      <%= image_tag photo.thumbnail, class: "w-full h-full object-cover" %>
    <% else %>
      <div class="w-full h-full flex items-center justify-center text-base-content/30 text-sm">
        No image
      </div>
    <% end %>
  </div>
<% end %>
