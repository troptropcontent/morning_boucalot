<div class="relative" data-photo-id="<%= photo.id %>">

  <%# Selection overlay %>
  <div class="select-overlay hidden absolute inset-0 z-10 bg-primary/25 pointer-events-none"></div>

  <%# Select circle button — for the owner and guests (both can download) %>
  <% if gallery_viewer?(@owner) %>
    <button class="select-btn absolute top-1.5 right-1.5 z-20 w-6 h-6 rounded-full border-2 border-white/70 bg-black/25 shadow flex items-center justify-center transition-colors before:content-[''] before:absolute before:-inset-2.5"
            data-action="click->photo-selection#toggleSelect"
            aria-label="Select photo">
      <svg class="select-check hidden w-4 h-4 text-primary-content" viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
        <path fill-rule="evenodd" clip-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"/>
      </svg>
    </button>
  <% end %>

  <%# Favorite button — visible to everyone; logging in is required to use it %>
  <div class="absolute bottom-1.5 left-1.5 z-20">
    <%= render "favorite_button", photo: photo, owner: @owner, favorited: @favorited_photo_ids.include?(photo.id) %>
  </div>

  <%= link_to user_photo_path(@owner, photo, tag: params[:tag].presence, favorited: params[:favorited].presence), class: "block active:opacity-75 transition-opacity", data: { turbo_frame: "_top" } do %>
    <div class="aspect-square overflow-hidden bg-base-300">
      <% if photo.file.attached? %>
        <%= image_tag photo.file.variant(:thumbnail), class: "w-full h-full object-cover" %>
      <% else %>
        <div class="w-full h-full flex items-center justify-center text-base-content/30 text-sm">
          No image
        </div>
      <% end %>
    </div>
  <% end %>
</div>
